---
import Logo from './Logo.astro';
/**
 * Compact site navigation keeps the app one action away. The phone menu is a native popover: Escape, tapping
 * outside and focus return all come from the browser, so the marketing pages ship no framework JavaScript.
 */
const links = [
  ['how-it-works', 'How it works'],
  ['recipes', 'The kitchen'],
  ['library', 'Food library'],
  ['about', 'Our story'],
];
---

<header class="site-header">
  <Logo />
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map(([path, title]) => <a href={`/busog/${path}/`}>{title}</a>)}
  </nav>
  <div class="header-actions">
    <button class="round theme-toggle" aria-label="Toggle light and dark theme">◐</button>
    <a class="button small-app" href="/busog/app/">Open Busog <span aria-hidden="true">↗</span></a>
    <button class="round menu-button" popovertarget="site-menu" aria-label="Open navigation">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
  </div>
  <div id="site-menu" class="site-menu" popover>
    <button class="round" popovertarget="site-menu" popovertargetaction="hide" aria-label="Close navigation">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
    <nav aria-label="Mobile navigation">
      {links.map(([path, title]) => <a href={`/busog/${path}/`}>{title}</a>)}
      <a class="menu-app" href="/busog/app/">Open Busog ↗</a>
    </nav>
  </div>
</header>
<script>
  document.querySelectorAll('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const theme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = theme;
      try {
        localStorage.setItem('busog-theme', theme);
      } catch {
        /* Theme remains usable in memory. */
      }
    });
  });
</script>
<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 26px 0;
  }
  nav {
    display: flex;
    gap: 30px;
  }
  nav a {
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-size: var(--text-sm);
  }
  .desktop-nav a {
    background: linear-gradient(currentColor, currentColor) 0 calc(50% + 0.8em) / 0 1px no-repeat;
    transition: background-size var(--base) var(--ease-out);
  }
  .desktop-nav a:hover {
    background-size: 100% 1px;
  }
  .header-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .small-app {
    font-size: var(--text-sm);
    padding: 12px 20px;
  }
  .theme-toggle,
  .menu-button {
    background: var(--raised);
    color: var(--ink);
  }
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .menu-button {
    display: none;
  }
  .site-menu {
    position: fixed;
    inset: max(18px, env(safe-area-inset-top)) 18px auto auto;
    width: min(300px, calc(100vw - 36px));
    margin: 0;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--raised);
    color: var(--ink);
    box-shadow: 0 24px 60px #0006;
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top right;
    transition:
      opacity var(--fast) var(--ease-out),
      transform var(--base) var(--ease-out),
      overlay var(--base) allow-discrete,
      display var(--base) allow-discrete;
  }
  .site-menu:popover-open {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .site-menu:popover-open {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
  .site-menu::backdrop {
    background: #0008;
  }
  .site-menu > button {
    display: flex;
    margin: 0 0 6px auto;
    background: var(--surface);
    color: var(--ink);
  }
  .site-menu nav {
    display: grid;
    gap: 2px;
  }
  .site-menu nav a {
    min-height: 48px;
    padding: 10px 16px;
    border-radius: 14px;
    font-size: var(--text-base);
  }
  .site-menu nav a:hover {
    background: var(--surface);
  }
  .site-menu .menu-app {
    margin-top: 6px;
    background: var(--coral);
    color: var(--card-ink);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .desktop-nav,
    .small-app {
      display: none;
    }
    .menu-button {
      display: inline-flex;
    }
  }
</style>
