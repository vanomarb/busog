---
import body from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import display from '@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url';
/** The two faces every first screen uses start downloading with the HTML, so headlines don't reflow on load. */
---

<link rel="preload" href={body} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={display} as="font" type="font/woff2" crossorigin />
