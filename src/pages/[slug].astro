---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import FinalCta from '../components/site/FinalCta.astro';
import FoodCharacter from '../components/app/FoodCharacter.svelte';
/** Generate a static page for every validated content entry. */
export async function getStaticPaths() {
  return (await getCollection('pages')).map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---

<SiteLayout title={page.data.title} description={page.data.description}>
  <section class="page-intro info-intro">
    <div><p class="mono">{page.data.eyebrow}</p><h1>{page.data.title}</h1><p>{page.data.description}</p></div>{
      page.data.kind === 'story' && (
        <div class="info-character aqua">
          <FoodCharacter kind={page.id === 'about' ? 'rice' : 'fish'} size={200} />
        </div>
      )
    }
  </section>
  <article class="reading"><Content /></article>
  {page.data.kind !== 'legal' && <FinalCta />}
</SiteLayout>
<style>
  .info-intro {
    max-width: none;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 45px;
    align-items: center;
  }
  .info-intro .mono {
    font-size: var(--text-xs);
    margin-bottom: 25px;
  }
  .info-character {
    width: 260px;
    height: 300px;
    border-radius: 100px 100px 32px 32px;
    display: grid;
    place-items: center;
    transform: rotate(5deg);
  }
  @media (max-width: 900px) {
    .info-intro {
      grid-template-columns: 1fr;
    }
    .info-character {
      width: 100%;
      height: 220px;
      border-radius: 30px;
      transform: none;
    }
  }
</style>
