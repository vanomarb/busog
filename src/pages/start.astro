---
import SiteLayout from '../layouts/SiteLayout.astro';
import AppButtons from '../components/site/AppButtons.astro';
---

<SiteLayout title="Your table is ready"
  ><section class="page-intro">
    <p class="mono">Welcome to Busog</p><h1>Your table<br />is ready.</h1><p>
      Open Busog right away, or begin with three short questions and an editable calorie starting point.
    </p>
  </section><div class="stack">
    <AppButtons /><a class="inline-link" href="/busog/quiz/">Set a starting point with the quiz ↗</a><a
      class="inline-link"
      href="/busog/app/?onboarding=1">Open optional onboarding ↗</a
    >
  </div></SiteLayout
>
