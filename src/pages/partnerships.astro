---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactForm from '../components/tools/ContactForm.svelte';
---

<SiteLayout title="Good food is a shared effort"
  ><section class="page-intro">
    <p class="mono">Partnerships</p><h1>Good food is<br />a shared effort.</h1><p>
      For the people who know everyday eating best: cooks, food researchers and Filipino communities.
    </p>
  </section><div class="split">
    <div class="stack">
      <h2>Build with context.</h2><p>
        We want to grow Busog with locally documented ingredient lists, accessible portion guides and better language
        around familiar meals. If that is your work too, let's talk.
      </p><h3>Start with the evidence.</h3><p class="muted">
        Every food contribution needs a source, a reproducible method and a clear license. Local familiarity matters; so
        does showing where a number came from.
      </p>
    </div><ContactForm partnership client:only="svelte" />
  </div></SiteLayout
>
