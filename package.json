{
  "name": "busog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/postbuild.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:domain": "tsx scripts/test-domain.ts && tsx scripts/test-state.ts",
    "check:limits": "node scripts/check-limits.mjs",
    "data:generate": "python3 scripts/snapshot.py",
    "quality": "npm run format && npm run format:check && npm run lint && npm run check && npm run test:domain && npm run check:limits"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.2",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lucide/svelte": "^1.63.0",
    "astro": "^7.4.4",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte-check": "^4.7.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
